LLM_MODEL=qwen2.5:3b

OLLAMA_HOST=http://localhost:11434

PRIMARY_LLM=ollama

FALLBACK_LLM=groq

# Multi-provider generation (preferred)
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDERS=gemini,cerebras,openrouter,mistral
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES_PER_PROVIDER=1

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama3.1-8b

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

CHROMA_DB_PATH=./chroma_db

COLLECTION_NAME=ml_notes

TOP_K=3

# Reranker A/B: default BGE. Use alias minilm or full id Xenova/ms-marco-MiniLM-L-6-v2
# RERANKER_MODEL=bge
# RERANKER_MODEL=minilm

SIMILARITY_THRESHOLD=1.3

# Agentic Mode is foundation-only until a later phase. Keep disabled.
AGENTIC_MODE_ENABLED=false
