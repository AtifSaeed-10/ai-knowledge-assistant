LLM_MODEL=qwen2.5:3b

OLLAMA_HOST=http://localhost:11434

PRIMARY_LLM=ollama

FALLBACK_LLM=groq

# Multi-provider generation (preferred)
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=groq,cerebras,openrouter,mistral
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES_PER_PROVIDER=1

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama3.1-8b

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# ========================
# Platform layer (auth, quotas, hosting)
# ========================
# Relational store. sqlite:///relative or sqlite:////absolute today.
DATABASE_URL=sqlite:///./data/documents.db

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,https://www.docusage.tech,https://docusage.tech

# "none" keeps guest-only mode. "supabase" enables Google sign-in.
AUTH_PROVIDER=none
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Anonymous trial
GUEST_TRIAL_ENABLED=true
QUOTA_GUEST_MAX_PDFS=1
QUOTA_GUEST_MAX_QUESTIONS=15

# Signed-in free tier
QUOTA_USER_MAX_PDFS=5
QUOTA_USER_MAX_QUESTIONS_MONTHLY=100

QUOTA_MAX_PDF_MB=25

# Operator dashboard. Only these Google emails can open /admin.
ADMIN_EMAILS=saeedatif199@gmail.com

# Azure VM credit card (hosting, not a model). Remaining is estimated
# unless you set AZURE_SPEND_USD (dollars already used).
AZURE_CREDIT_START_USD=100
AZURE_CREDIT_EXPIRES=2027-09-05
AZURE_VM_HOURLY_USD=0.05
# AZURE_CREDIT_STARTED_AT=2026-08-01
# AZURE_SPEND_USD=12.40

CHROMA_DB_PATH=./chroma_db

COLLECTION_NAME=ml_notes

TOP_K=3

# Reranker A/B: default BGE. Use alias minilm or full id Xenova/ms-marco-MiniLM-L-6-v2
# RERANKER_MODEL=bge
# RERANKER_MODEL=minilm

SIMILARITY_THRESHOLD=1.3

# Agentic Mode is foundation-only until a later phase. Keep disabled.
AGENTIC_MODE_ENABLED=false
